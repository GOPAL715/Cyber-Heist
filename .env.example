# ---------------------------------------------------------------------------
# Cyber Heist - example environment file
#
# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# NEVER commit a real `.env`. It is already ignored by .gitignore.
# ---------------------------------------------------------------------------

# ------------------------------ Database ------------------------------------
POSTGRES_DB=cyberheist
POSTGRES_USER=cyberheist
# CHANGE THIS. Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=change_me_postgres_password

# Backend datasource (used by Spring Boot when running outside Docker)
DB_URL=jdbc:postgresql://localhost:5432/cyberheist
DB_USERNAME=cyberheist
DB_PASSWORD=change_me_postgres_password

# ------------------------------ Backend -------------------------------------
SERVER_PORT=8080

# JWT signing secret. MUST be >= 32 bytes for HS256.
# Generate one with: openssl rand -base64 64
JWT_SECRET=change_me_jwt_secret_at_least_32_bytes_long
JWT_ISSUER=cyber-heist

# Durations in ISO-8601 format
JWT_ACCESS_EXPIRATION=PT15M
REFRESH_TOKEN_EXPIRATION=P7D

# Comma-separated list of origins allowed to call the API.
# Never use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth endpoint rate limiting
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW=PT1M

# ------------------------------ Frontend ------------------------------------
# Base URL of the backend API as seen from the browser
VITE_API_BASE_URL=http://localhost:8080